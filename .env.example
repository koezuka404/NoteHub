JWT_SECRET=change-me-to-at-least-32-characters-long-secret

APP_ENV=development
HTTP_PORT=8080
PORT=8080

DATABASE_URL=postgres://notehub:notehub@localhost:5436/notehub?sslmode=disable
REDIS_URL=redis://localhost:6382/0
REDIS_OPERATION_TIMEOUT=2s

JWT_ISSUER=notehub-api
JWT_AUDIENCE=notehub-client
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

BCRYPT_COST=12

COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_NAME=notehub_refresh_token
CSRF_TOKEN_COOKIE_NAME=notehub_csrf_token

CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_HTTP_URL=http://localhost:8081

LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=1h
LOGIN_LOCK_DURATION=1h
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=1

WS_MAX_CONNECTIONS_PER_DOCUMENT=3
DOCUMENT_AUTOSAVE_INTERVAL=10s
DOCUMENT_AUTOSAVE_IDLE_DURATION=60s

CLEANUP_BATCH_INTERVAL=1h
REFRESH_TOKEN_RETENTION=720h
BACKUP_ENABLED=false
BACKUP_BATCH_INTERVAL=24h
BACKUP_DIR=./backups
BACKUP_RETENTION=168h
