APP_ENV=production

HTTP_PORT=8080

DATABASE_URL=postgres://notehub:notehub@localhost:5432/notehub?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-at-least-32-characters-long-secret

JWT_ISSUER=notehub-api
JWT_AUDIENCE=notehub-client

CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGIN_SUFFIXES=.vercel.app
PUBLIC_HTTP_URL=https://your-api.onrender.com

COOKIE_SECURE=true
COOKIE_SAME_SITE=None

TRUSTED_PROXY_CIDRS=
CLIENT_IP_HEADER=X-Vercel-Forwarded-For

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_COST=12
