# Vercel (frontend) environment variables
# Vercel Dashboard > Project Settings > Environment Variables

# Render backend URL (no trailing slash)
VITE_API_BASE_URL=https://your-api.onrender.com

# WebSocket URL (no trailing slash, use wss:// in production)
VITE_WS_BASE_URL=wss://your-api.onrender.com

# Use the exact URL shown in Render Dashboard (may differ from service name).
# CSRF: login/refresh responses include csrfToken; the app stores it in sessionStorage
# and sends X-CSRF-Token on refresh/logout. Render needs COOKIE_SAME_SITE=None.

# Local development (vite proxy — leave unset or use .env.local)
# VITE_PROXY_TARGET=http://localhost:8081
